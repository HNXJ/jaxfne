  "question": "Under frozen geometry and delay manipulations, does neural activity X(r,t) yield preregistered traveling-wave classifications via validated W_hat?",
  "causal_chain": {
    "display": "G -> (W,tau) -> X(r,t) -> W_hat",
    "optional_secondary": ["Q(r,t)", "Phi(r,t)"],
    "primary_substrate": "X",
    "secondary_rule": "Q and Phi may be analyzed only where existing frozen mappings are already defined; they are never primary endpoints.",
    "upstream_feed_prohibited": true,
    "protocol_d_vs_c": {
      "protocol_d": "how signals are delayed (tau construction and runtime continuation)",
      "protocol_c": "whether resulting activity exhibits propagation (classification only)"
    }
  },
  "runtime_contract": {
    "path": "Model.simulate with return_state=False unless segmented continuation explicitly required",
    "enable_hdp": false,
    "enable_homeostasis": false,
    "enable_rbd": false,
    "recurrent_backend": "edge_list",
    "synaptic_kernel": "exponential",
    "delay_continuation": "C2 canonical delay_state when segmented; baseline recurrent only",
    "rationale": "C2 validated baseline delay_state continuation; HDP+delay continuation is out of scope for C3."
  },
  "frozen_topology_and_weights": {
    "topology": "directed_one_neighbor_ring",
    "n_neurons": 24,
    "edge_weight": 6.0,
    "syn_tau_ms": 3.0,
    "receptor_index": 0,
    "emitter": "izhikevich",
    "labels": "all_excitatory_E",
    "weight_mutability": "fixed_for_all_conditions_and_seeds"
  },
  "frozen_spatial_coordinates": {
    "embedding": "planar_ring",
    "ring_radius_mm": 1.0,
    "coordinate_construction_ordered": "theta_i = 2*pi*i/N; r_i = (R*cos(theta_i), R*sin(theta_i)); analysis_axis = arc_length_i = R*theta_i",
    "units": "mm",
    "estimator_positions": "arc_length_column_vector_shape_(N,1)"
  },
  "geometry_shuffle": {
    "algorithm": "fisher_yates_permutation",
    "applies_to": "neuron_index_to_position_assignment",
    "preserves": ["edge_pre_post_topology", "edge_weight_multiset", "delay_multiset_when_delay_shuffled_only"],
    "breaks": "spatial_ordering_of_neuron_labels_relative_to_ring_coordinates",
    "seed_rule": "geometry_shuffle_seed = base_geometry_seed + condition_index * 9973",
    "base_geometry_seed": 4242
  },
  "delay_construction": {
    "grid_alignment": "edge_delay_steps_from_ms with atol=1e-9 (Protocol D0)",
    "dt_ms": 0.5,
    "uniform_delay_steps": 4,
    "geometry_derived": {
      "rule": "tau_ij_ms = arc_length_ij / v_c; delay_steps_ij = tau_ij_ms / dt_ms (grid-aligned)",
      "arc_length_ij": "directed ring arc from pre to post: (2*pi*R)/N",
      "conduction_velocity_mm_per_ms": 0.2617993877991494,
      "conduction_velocity_definition": "v_c = (2*pi*R/N) / (uniform_delay_steps * dt_ms) so geometry-derived neighbor delay matches uniform reference scale",
      "geometry_derived_delay_steps_neighbor": 4,
      "note": "On a uniform ring all directed neighbor arcs are equal; heterogeneity enters via shuffle controls not unequal arc lengths."
    },
    "delay_shuffle_control": {
      "algorithm": "fisher_yates_permutation_on_edge_delay_vector",
      "preserves": "exact_delay_steps_multiset",
      "breaks": "correspondence_between_edge_identity_and_delay",
      "reference_policy": "geometry_derived",
      "seed_rule": "delay_shuffle_seed = base_delay_shuffle_seed + condition_index * 7919",
      "base_delay_shuffle_seed": 5150
    }
  },
  "design_matrix": {
    "factors": {
