cff-version: 1.2.0
message: "If you use jaxfne, please cite it using the metadata in this file."
title: "jaxfne: JAX Field Neural Equations"
type: software
version: 0.4.16
date-released: "2026-08-13"
license: MIT
repository-code: "https://github.com/HNXJ/jaxfne"
url: "https://jaxfne.readthedocs.io/en/latest/"
abstract: >
  JAX-based simulation of Tensor-Field Neural Equations: population simulation,
  emitter-to-source-to-field readouts (LFP, CSD, EEG/MEG), spectrolaminar
  workflows, and Jaxley interoperability. All outputs are Relative-value unless
  an explicit calibration step is supplied.
authors:
  - family-names: Nejat
    given-names: Hamed
keywords:
  - neuroscience
  - neural simulation
  - JAX
  - laminar cortex
  - LFP
  - computational neuroscience
  - tensor field neural equations
identifiers:
