{
  "schema": "jaxfne-dashboard-sources/1",
  "repo_url": "https://github.com/hnxj/jaxfne",
  "key_syntax": "Dotted path into a JSON file named in 'files'. 'per_run' specs select list items with 'where' (exact match) and read 'key' from each.",
  "papers": [
    {
      "id": "caminos",
      "title": "CAMINOS reference model, Fig. 1",
      "citation": "Tahvili, Vinck and di Volo, PLoS Comput Biol 2026",
      "release": "0.5.6",
      "tier": "T-methods",
      "stage": "P5",
      "lane": {"branch": "l2-caminos", "sha": "20045e9a46cda81638a8c9fd75477be06dda34d0"},
      "verdict": "not reproduced",
      "summary": "Gamma, the PV→SOM lag and the rate order reproduce at p = 0.07; the critical-p onset (R4) runs in reverse with the external drive fixed at 560 sources. R4 is being rescored under amendment v7 (drive p·NE).",
      "preregs": [
        {"id": "v6", "signed": "2026-10-11", "path": "artifacts/etudes/caminos/PREREG_P3.md"},
        {"id": "v7 (R4 only)", "signed": "2026-10-12", "path": "artifacts/etudes/caminos/PREREG_P3_v7_R4.md"}
      ],
      "files": {
        "main": "artifacts/etudes/caminos/scores/score.json",
        "sens": "artifacts/etudes/caminos/scores/sensitivity_S1_S5.json",
        "v7": {"path": "artifacts/etudes/caminos/scores/score_v7.json", "allow_missing": true}
      },
      "criteria": [
        {"id": "R1", "claim": "the network oscillates at about 35 Hz", "estimand": "peak frequency f_pk of the E rate spectrum, seeds 1–5 at p = 0.07", "criterion": "every seed oscillates, f_pk 30–40 Hz",
         "value": {"file": "main", "key": "r1.mean_peak_freq_Hz"}, "unit": "Hz", "value_label": "mean f_pk",
         "verdict": {"file": "main", "key": "r1.pass"}, "prereg": "v6"},
        {"id": "R2", "claim": "SOM fires after PV within each cycle, about 8.5 ms", "estimand": "lag of the PV→SOM rate cross-correlation peak, mean over seeds", "criterion": "lag positive in every seed, mean 6–11 ms",
         "value": {"file": "main", "key": "r2.mean_lag_ms"}, "unit": "ms", "value_label": "mean lag",
         "verdict": {"file": "main", "key": "r2.pass"}, "prereg": "v6"},
        {"id": "R3", "claim": "rates order PV > SOM > E, E at 1–3 Hz", "estimand": "mean rate per population over the kept 10 s", "criterion": "PV > SOM > E in every seed, mean E 1–3 Hz",
         "value": {"file": "main", "key": "r3.mean_E_Hz"}, "unit": "Hz", "value_label": "mean E rate",
         "verdict": {"file": "main", "key": "r3.pass"}, "prereg": "v6"},
        {"id": "R4", "claim": "oscillations appear above a critical p (Fig. 1E)", "estimand": "oscillation at p = 0.02–0.10, seeds 1–3, drive 560 sources", "criterion": "no seed oscillates at p = 0.02; all seeds oscillate at p = 0.07",
         "value": {"file": "main", "key": "r4.smallest_oscillating_p"}, "unit": "", "value_label": "smallest p where all seeds oscillate",
         "verdict": {"file": "main", "key": "r4.pass"}, "prereg": "v6",
         "reason": "every run oscillates, p = 0.02 included; peak excess is largest at low p"},
        {"id": "R4v7", "claim": "oscillations appear above a critical p (Fig. 1E)", "estimand": "as R4, with drive round(p·NE) sources", "criterion": "no seed oscillates at p = 0.02 while E fires (≥ 0.1 Hz); all seeds oscillate at p = 0.07",
         "value": {"file": "v7", "key": "r4.smallest_oscillating_p"}, "unit": "", "value_label": "smallest p where all seeds oscillate",
         "verdict": {"file": "v7", "key": "r4.pass"}, "prereg": "v7 (R4 only)",
         "floor": {"file": "v7", "from": "per_run", "where": {"p": 0.02}, "key": "rates_Hz.E", "min": 0.1},
         "reason": ""}
      ],
      "sensitivity": [
        {"id": "S1", "label": "float64", "status": "agrees", "note": "every value inside the seed range; f_pk moves 1 Hz from seed 1, equal to the seed range and the 1 Hz grid step"},
        {"id": "S2", "label": "dt 0.05 ms", "status": "agrees", "note": "every shift inside the seed range"},
        {"id": "S3", "label": "fixed in-degree", "status": "differs", "note": "small shifts past the seed range (f_pk +1 Hz; E, PV and lag slightly low); R1–R3 bands still met"},
        {"id": "S4", "label": "shared drive (560 trains at p)", "status": "invalid", "note": "a cell sees about 39 sources instead of 560, so the drive falls 14-fold and E is silent; not a test of shared input"},
        {"id": "S5", "label": "Brian2 step order", "status": "differs", "note": "small shifts past the seed range (E, PV and SOM slightly high); R1–R3 bands still met"}
      ],
      "sensitivity_metrics": [
        {"metric": "f_pk", "unit": "Hz", "key": "peak_freq_E_Hz"},
        {"metric": "E rate", "unit": "Hz", "key": "rates_Hz.E"},
        {"metric": "PV rate", "unit": "Hz", "key": "rates_Hz.PV"},
        {"metric": "SOM rate", "unit": "Hz", "key": "rates_Hz.SOM"},
        {"metric": "PV→SOM lag", "unit": "ms", "key": "lag_PV_SOM_ms"}
      ],
      "sensitivity_source": {"file": "sens", "key_prefix": "<id>."},
      "sensitivity_ref": {"file": "main", "from": "per_run", "where": {"p": 0.07, "seed": 1}},
      "sensitivity_range": {"file": "main", "from": "per_run", "where": {"p": 0.07}},
      "charts": [
        {"id": "r4_peak_excess", "kind": "lines", "title": "Oscillation strength against p",
         "x": {"label": "connection probability p"}, "y": {"label": "peak excess (E spectrum)", "log": true},
         "series": [
           {"group": "v6: 560 sources", "file": "main", "from": "per_run", "where": {}, "x": "p", "y": "peak_excess_E", "split": "seed", "seeds": [1, 2, 3]},
           {"group": "v7: p·NE sources", "file": "v7", "from": "per_run", "where": {}, "x": "p", "y": "peak_excess_E", "split": "seed", "seeds": [1, 2, 3]}
         ],
         "refs": [{"kind": "hline", "y": 4, "label": "oscillation threshold 4"}],
         "caption": "Peak excess of the E rate spectrum per run; a run oscillates above 4. Lines join one seed across p."},
        {"id": "r4_rates", "kind": "lines", "title": "Population rates against p",
         "x": {"label": "connection probability p"}, "y": {"label": "rate", "unit": "Hz", "log": true},
         "series": [
           {"group": "v6 E", "file": "main", "from": "per_run", "where": {}, "x": "p", "y": "rates_Hz.E", "split": "seed", "seeds": [1, 2, 3]},
           {"group": "v6 PV", "file": "main", "from": "per_run", "where": {}, "x": "p", "y": "rates_Hz.PV", "split": "seed", "seeds": [1, 2, 3]},
           {"group": "v7 E", "file": "v7", "from": "per_run", "where": {}, "x": "p", "y": "rates_Hz.E", "split": "seed", "seeds": [1, 2, 3]},
           {"group": "v7 PV", "file": "v7", "from": "per_run", "where": {}, "x": "p", "y": "rates_Hz.PV", "split": "seed", "seeds": [1, 2, 3]}
         ],
         "refs": [{"kind": "hline", "y": 0.1, "label": "v7 E floor 0.1 Hz"}],
         "caption": "Mean rates over the kept 10 s, seeds 1–3."},
        {"id": "ref_seeds", "kind": "lines", "title": "Reference point p = 0.07, seeds 1–5",
         "x": {"label": "seed"}, "y": {"label": "f_pk", "unit": "Hz"},
         "series": [{"group": "f_pk", "file": "main", "from": "per_run", "where": {"p": 0.07}, "x": "seed", "y": "peak_freq_E_Hz", "markers_only": true}],
         "refs": [{"kind": "band", "y0": 30, "y1": 40, "label": "R1 band 30–40 Hz"}],
         "caption": "Peak frequency per seed at the reference point."}
      ],
      "open": [
        "R4v7 scoring: runs in progress (identity check passed 2026-10-12).",
        "Shared drive at equal mean drive (NE trains at probability p) is untested.",
        "P6 library path not attempted (B1)."
      ]
    },
    {
      "id": "pcl-fig3",
      "title": "Predictive coding light, Fig. 3 (simple and complex cell tuning)",
