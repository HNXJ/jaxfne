      "stage": "P5",
      "lane": {"branch": "pcl-port", "sha": "5640ce18a42b25f572530508628a215081811b4b"},
      "verdict": "not reproduced",
      "summary": "Orientation tuning and the simple/complex phase split reproduce; sf tuning is broad (R_sf about 1.5 against 2) and complex cells show no frequency doubling.",
      "preregs": [{"id": "v4", "signed": "2026-10-11", "path": "artifacts/etudes/pcl/prereg/P3_fig3.md"}],
      "files": {
        "main": "artifacts/etudes/pcl/prereg/scores/fig3_v4_full.json",
        "S1": "artifacts/etudes/pcl/prereg/scores/fig3_v4_S1.json",
        "S2": "artifacts/etudes/pcl/prereg/scores/fig3_v4_S2.json",
        "S3_33": "artifacts/etudes/pcl/prereg/scores/fig3_v4_S3_3_3.json",
        "S3_34": "artifacts/etudes/pcl/prereg/scores/fig3_v4_S3_3_4.json",
        "S3_43": "artifacts/etudes/pcl/prereg/scores/fig3_v4_S3_4_3.json"
      },
      "criteria": [
        {"id": "T1", "group": "simple", "claim": "simple cells are orientation tuned", "estimand": "R_ori, held-out phases", "criterion": "R_ori ≥ 2 and above both null 99th percentiles",
         "value": {"file": "main", "key": "t1_r_ori_simple"}, "unit": "", "value_label": "R_ori",
         "extra": [{"label": "N-label 99th", "file": "main", "key": "t1_r_ori_simple_null99"}, {"label": "N-pref 99th", "file": "main", "key": "t1_r_ori_simple_npref99"}],
         "verdict": {"file": "main", "key": "t1_simple_pass"}, "prereg": "v4"},
        {"id": "T1", "group": "complex", "claim": "complex cells are orientation tuned", "estimand": "R_ori, held-out phases", "criterion": "R_ori ≥ 2 and above both null 99th percentiles",
         "value": {"file": "main", "key": "t1_r_ori_complex"}, "unit": "", "value_label": "R_ori",
         "extra": [{"label": "N-label 99th", "file": "main", "key": "t1_r_ori_complex_null99"}, {"label": "N-pref 99th", "file": "main", "key": "t1_r_ori_complex_npref99"}],
         "verdict": {"file": "main", "key": "t1_complex_pass"}, "prereg": "v4"},
        {"id": "T2", "group": "simple", "claim": "simple cells are spatial-frequency tuned", "estimand": "R_sf, held-out phases", "criterion": "R_sf ≥ 2 and above both null 99th percentiles",
         "value": {"file": "main", "key": "t2_r_sf_simple"}, "unit": "", "value_label": "R_sf",
         "extra": [{"label": "N-label 99th", "file": "main", "key": "t2_r_sf_simple_null99"}, {"label": "N-pref 99th", "file": "main", "key": "t2_r_sf_simple_npref99"}],
         "verdict": {"file": "main", "key": "t2_simple_pass"}, "prereg": "v4", "reason": "above both nulls, under the ratio of 2"},
        {"id": "T2", "group": "complex", "claim": "complex cells are spatial-frequency tuned", "estimand": "R_sf, held-out phases", "criterion": "R_sf ≥ 2 and above both null 99th percentiles",
         "value": {"file": "main", "key": "t2_r_sf_complex"}, "unit": "", "value_label": "R_sf",
         "extra": [{"label": "N-label 99th", "file": "main", "key": "t2_r_sf_complex_null99"}, {"label": "N-pref 99th", "file": "main", "key": "t2_r_sf_complex_npref99"}],
         "verdict": {"file": "main", "key": "t2_complex_pass"}, "prereg": "v4", "reason": "above both nulls, under the ratio of 2"},
        {"id": "T3", "group": "simple", "claim": "simple cells are phase modulated", "estimand": "median excess modulation X (per trial, Poisson null)", "criterion": "median X ≥ 0.15",
         "value": {"file": "main", "key": "median_X_simple"}, "unit": "", "value_label": "median X",
         "verdict": {"file": "main", "key": "t3_simple_pass"}, "prereg": "v4"},
        {"id": "T3", "group": "complex", "claim": "complex cells are phase invariant", "estimand": "median excess modulation X", "criterion": "median X ≤ 0.5 × simple median X",
         "value": {"file": "main", "key": "median_X_complex"}, "unit": "", "value_label": "median X",
         "verdict": {"file": "main", "key": "t3_complex_pass"}, "prereg": "v4"},
        {"id": "T4", "group": "both", "claim": "complex cells frequency-double, simple cells do not", "estimand": "median L = log(A(2ω)/A(ω)) per set", "criterion": "median L simple < 0 < median L complex, difference above its null 99th",
         "value": {"file": "main", "key": "median_L_complex"}, "unit": "", "value_label": "median L complex",
         "extra": [{"label": "median L simple", "file": "main", "key": "median_L_simple"}, {"label": "difference", "file": "main", "key": "t4_diff"}, {"label": "null 99th", "file": "main", "key": "t4_diff_null99"}],
         "verdict": {"file": "main", "key": "t4_pass"}, "prereg": "v4", "reason": "complex median below 0; the set difference beats its null"}
      ],
      "sensitivity": [
        {"id": "S1", "label": "lateral and top-down maps zeroed", "status": "differs", "file": "S1", "note": "T1 and simple T3 fail: the maps matter, so map order is not excluded"},
        {"id": "S2", "label": "preferences on all phases", "status": "agrees", "file": "S2", "keys_prefix": "s2_", "note": "the fold does not explain T2"},
        {"id": "S3 (3,3)", "label": "simple column (3,3)", "status": "agrees", "file": "S3_33", "note": "same verdicts"},
        {"id": "S3 (3,4)", "label": "simple column (3,4)", "status": "agrees", "file": "S3_34", "note": "same verdicts"},
        {"id": "S3 (4,3)", "label": "simple column (4,3)", "status": "agrees", "file": "S3_43", "note": "same verdicts"}
      ],
      "sensitivity_metrics": [
        {"metric": "R_ori simple", "key": "t1_r_ori_simple"},
        {"metric": "R_ori complex", "key": "t1_r_ori_complex"},
        {"metric": "R_sf simple", "key": "t2_r_sf_simple"},
        {"metric": "R_sf complex", "key": "t2_r_sf_complex"},
        {"metric": "median X simple", "key": "median_X_simple", "skip_with_prefix": true},
        {"metric": "median L complex", "key": "median_L_complex", "skip_with_prefix": true}
      ],
      "sensitivity_ref": {"file": "main"},
      "charts": [
        {"id": "t1t2", "kind": "bars", "title": "T1 and T2 ratios against nulls and criterion",
         "categories": ["R_ori simple", "R_ori complex", "R_sf simple", "R_sf complex"],
         "y": {"label": "ratio"},
         "series": [
           {"group": "scored", "file": "main", "keys": ["t1_r_ori_simple", "t1_r_ori_complex", "t2_r_sf_simple", "t2_r_sf_complex"]},
           {"group": "N-label 99th", "file": "main", "keys": ["t1_r_ori_simple_null99", "t1_r_ori_complex_null99", "t2_r_sf_simple_null99", "t2_r_sf_complex_null99"]},
           {"group": "N-pref 99th", "file": "main", "keys": ["t1_r_ori_simple_npref99", "t1_r_ori_complex_npref99", "t2_r_sf_simple_npref99", "t2_r_sf_complex_npref99"]}
         ],
         "refs": [{"kind": "hline", "y": 2, "label": "criterion 2"}],
         "caption": "Held-out ratios with the 99th percentiles of both nulls (1000 draws)."},
        {"id": "t3t4", "kind": "bars", "title": "T3 phase modulation and T4 frequency doubling",
         "categories": ["median X simple", "median X complex", "median L simple", "median L complex"],
         "y": {"label": "statistic"},
         "series": [{"group": "scored", "file": "main", "keys": ["median_X_simple", "median_X_complex", "median_L_simple", "median_L_complex"]}],
         "refs": [{"kind": "hline", "y": 0, "label": "0"}, {"kind": "hline", "y": 0.15, "label": "T3 simple floor 0.15"}],
         "caption": "T4 needs median L complex above 0."},
        {"id": "sens_rsf", "kind": "bars", "title": "R_sf across sensitivity runs",
         "categories": ["scored (4,4)", "S1 maps off", "S2 all phases", "S3 (3,3)", "S3 (3,4)", "S3 (4,3)"],
         "y": {"label": "R_sf"},
         "series": [
           {"group": "simple", "pairs": [["main", "t2_r_sf_simple"], ["S1", "t2_r_sf_simple"], ["S2", "s2_t2_r_sf_simple"], ["S3_33", "t2_r_sf_simple"], ["S3_34", "t2_r_sf_simple"], ["S3_43", "t2_r_sf_simple"]]},
           {"group": "complex", "pairs": [["main", "t2_r_sf_complex"], ["S1", "t2_r_sf_complex"], ["S2", "s2_t2_r_sf_complex"], ["S3_33", "t2_r_sf_complex"], ["S3_34", "t2_r_sf_complex"], ["S3_43", "t2_r_sf_complex"]]}
         ],
         "refs": [{"kind": "hline", "y": 2, "label": "criterion 2"}],
         "caption": "R_sf stays under 2 in every variant."}
      ],
      "open": [
        "The authors compute neither an sf selectivity index nor F1/F0; T2's ratio and T4's log ratio are the prereg's (diagnostic, unscored).",
