{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jaxfne replication dashboard data (jaxfne-replications/2)",
  "description": "Checked by scripts/build_dashboard_data.py --check. Only type, required, properties, items, pattern and enum are read; any other keyword makes the check refuse. Every git SHA field is 40 lower-case hex; every sha256 field is 64 lower-case hex.",
  "type": "object",
  "required": ["schema", "sample", "generated", "papers", "overview", "roadmap", "studies"],
  "properties": {
    "schema": {"type": "string", "enum": ["jaxfne-replications/2"]},
    "sample": {"type": "boolean"},
    "generated": {
      "type": "object",
      "required": ["utc", "dev_sha", "data_revision"],
      "properties": {
        "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "dev_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "data_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "class", "lane", "preregs", "criteria", "charts", "stage_artifacts", "verdict_summary", "replica"],
        "properties": {
          "id": {"type": "string"},
          "class": {
            "type": "string",
            "enum": ["reproduced", "reproduced (conditional)", "mixed", "pending", "in progress", "not started", "core method"]
          },
          "lane": {
            "type": "object",
            "required": ["branch", "sha"],
            "properties": {
              "branch": {"type": "string"},
              "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          },
          "preregs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "path"],
              "properties": {
                "id": {"type": "string"},
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "verdict", "evidence"],
              "properties": {
                "verdict": {"type": "string", "enum": ["pass", "fail", "pending"]},
                "evidence": {
                  "type": "object",
                  "required": ["path", "url"],
                  "properties": {
                    "path": {"type": "string"},
                    "url": {"type": ["string", "null"]},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              }
            }
          },
          "charts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "evidence"],
              "properties": {
                "evidence": {
                  "type": "object",
                  "required": ["path", "url"],
                  "properties": {
                    "path": {"type": "string"},
                    "url": {"type": ["string", "null"]},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              }
            }
          },
          "stage_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stage", "items"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label", "path"],
                    "properties": {
                      "path": {"type": "string"},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  }
                }
              }
            }
          },
          "verdict_summary": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "library": {
                "type": ["object", "null"],
                "properties": {
                  "evidence": {
                    "type": "object",
                    "required": ["path", "url"],
                    "properties": {
                      "path": {"type": "string"},
                      "url": {"type": ["string", "null"]},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  }
                }
              }
            }
          },
          "replica": {
            "type": "object",
            "required": ["score", "panels", "excluded", "counts", "same_as", "items"],
            "properties": {
              "score": {"type": ["integer", "null"]},
              "panels": {"type": "integer"},
              "excluded": {"type": "integer"},
              "same_as": {"type": ["string", "null"]},
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "status"],
                  "properties": {"status": {"type": "string", "enum": ["pass", "partial", "fail", "not run"]}}
                }
              }
            }
          }
        }
      }
    },
    "overview": {"type": "object"},
    "roadmap": {"type": "array"},
    "studies": {
      "type": "array",
      "items": {"type": "object", "required": ["reference", "status", "where"]}
    },
    "audit": {
      "type": "object",
      "required": ["method", "agreement", "rows"],
      "properties": {
        "method": {"type": "string"},
        "agreement": {
          "type": "object",
          "required": ["H1", "H2", "H3"],
          "properties": {
            "H1": {"type": "object", "required": ["alpha", "shuffle_p95"], "properties": {"alpha": {"type": "number"}, "shuffle_p95": {"type": "number"}}},
            "H2": {"type": "object", "required": ["alpha", "shuffle_p95"], "properties": {"alpha": {"type": "number"}, "shuffle_p95": {"type": "number"}}},
            "H3": {"type": "object", "required": ["alpha", "shuffle_p95"], "properties": {"alpha": {"type": "number"}, "shuffle_p95": {"type": "number"}}}
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["line", "reference", "section", "H1", "H2", "H3", "action"],
            "properties": {
              "line": {"type": "integer"},
              "reference": {"type": "string"},
              "section": {"type": "string"},
              "H1": {"type": ["number", "null"]},
              "H2": {"type": ["number", "null"]},
              "H3": {"type": ["number", "null"]},
              "action": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
